{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "image-viewer-on-tauri",
  "version": "1.0.1",
  "identifier": "com.satake.image-viewer-on-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "image-viewer-on-tauri",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$TEMP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "realcugan_2x_conservative.onnx": "realcugan_2x_conservative.onnx",
      "realcugan_4x_conservative.onnx": "realcugan_4x_conservative.onnx",
      "realcugan-ncnn-vulkan/realcugan-ncnn-vulkan.exe": "realcugan-ncnn-vulkan/realcugan-ncnn-vulkan.exe",
      "realcugan-ncnn-vulkan/vcomp140.dll": "realcugan-ncnn-vulkan/vcomp140.dll",
      "realcugan-ncnn-vulkan/models-se/up2x-conservative.bin": "realcugan-ncnn-vulkan/models-se/up2x-conservative.bin",
      "realcugan-ncnn-vulkan/models-se/up2x-conservative.param": "realcugan-ncnn-vulkan/models-se/up2x-conservative.param",
      "realcugan-ncnn-vulkan/models-se/up4x-conservative.bin": "realcugan-ncnn-vulkan/models-se/up4x-conservative.bin",
      "realcugan-ncnn-vulkan/models-se/up4x-conservative.param": "realcugan-ncnn-vulkan/models-se/up4x-conservative.param",
      "realcugan-ncnn-vulkan/models-se/up2x-no-denoise.bin": "realcugan-ncnn-vulkan/models-se/up2x-no-denoise.bin",
      "realcugan-ncnn-vulkan/models-se/up2x-no-denoise.param": "realcugan-ncnn-vulkan/models-se/up2x-no-denoise.param",
      "realcugan-ncnn-vulkan/models-se/up4x-no-denoise.bin": "realcugan-ncnn-vulkan/models-se/up4x-no-denoise.bin",
      "realcugan-ncnn-vulkan/models-se/up4x-no-denoise.param": "realcugan-ncnn-vulkan/models-se/up4x-no-denoise.param"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}